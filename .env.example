# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority

# Secret used to sign admin JWT auth cookies (use a long random string)
JWT_SECRET=change-this-to-a-long-random-secret

# Default admin account created automatically the first time the app runs
# if no admin exists in the database yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
